# QuantRisk OS - Environment Configuration
# Copy to .env and adjust values as needed

# Database URL (SQLite default — no setup required)
DATABASE_URL=sqlite:///./quantrisk.db

# Debug mode (set False in production)
DEBUG=False

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application port (for reference — set in uvicorn command)
APP_PORT=8000

# Log level
LOG_LEVEL=INFO
